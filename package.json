{
    "name": "openrgb-deck",
    "version": "0.1.0",
    "description": "OpenRGB profile control for Elgato Stream Deck",
    "private": true,
    "type": "module",
    "license": "GPL-2.0-or-later",
    "author": "ThatGuyJacobee (https://github.com/ThatGuyJacobee)",
    "homepage": "https://github.com/ThatGuyJacobee/OpenRGB-Deck#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThatGuyJacobee/OpenRGB-Deck.git"
    },
    "bugs": {
        "url": "https://github.com/ThatGuyJacobee/OpenRGB-Deck/issues"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "node scripts/icons.mjs && rollup -c",
        "watch": "node scripts/icons.mjs && rollup -c -w --watch.onEnd=\"streamdeck restart com.thatguyjacobee.openrgbdeck\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "icons": "node scripts/icons.mjs",
        "validate": "node scripts/icons.mjs && streamdeck validate com.thatguyjacobee.openrgbdeck.sdPlugin",
        "pack": "node scripts/icons.mjs && streamdeck pack com.thatguyjacobee.openrgbdeck.sdPlugin"
    },
    "prettier": "@elgato/prettier-config",
    "devDependencies": {
        "@elgato/cli": "^1.10.4",
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@eslint/js": "^9.26.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.1.0",
        "eslint": "^9.26.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "prettier": "^3.9.10",
        "rollup": "^4.0.2",
        "sharp": "^0.35.5",
        "tslib": "^2.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.32.0"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.4"
    }
}
